{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-data-v2.schema.json",
  "title": "Killkiss Sheet3 card data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "category",
    "categoryName",
    "cards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "category": {
      "enum": [
        "ranged",
        "heavy",
        "bleed",
        "flexible",
        "hidden",
        "defense",
        "magic",
        "enemy_dog",
        "enemy_ghost",
        "enemy_cat",
        "enemy_nightmare",
        "enemy_little_girl",
        "enemy_fatty",
        "enemy_thief",
        "enemy_merchant",
        "enemy_butcher",
        "enemy_big_eye"
      ]
    },
    "categoryName": {
      "type": "string",
      "minLength": 1
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "valuePair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "upgraded"
      ],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0
        },
        "upgraded": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "numberOrPair": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/valuePair"
        }
      ]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "category",
        "copies",
        "cost",
        "special",
        "effects",
        "source",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zhCN",
            "en"
          ],
          "properties": {
            "zhCN": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "description": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "zhCN": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "category": {
          "enum": [
            "ranged",
            "heavy",
            "bleed",
            "flexible",
            "hidden",
            "defense",
            "magic",
            "enemy_dog",
            "enemy_ghost",
            "enemy_cat",
            "enemy_nightmare",
            "enemy_little_girl",
            "enemy_fatty",
            "enemy_thief",
            "enemy_merchant",
            "enemy_butcher",
            "enemy_big_eye"
          ]
        },
        "copies": {
          "type": "integer",
          "minimum": 1
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource",
            "amount"
          ],
          "properties": {
            "resource": {
              "enum": [
                "action_point",
                "mana"
              ]
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "special": {
          "type": "boolean"
        },
        "tutorial": {
          "$ref": "#/$defs/tutorialHint"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workbook",
            "sheet",
            "row"
          ],
          "properties": {
            "workbook": {
              "type": "string"
            },
            "sheet": {
              "type": "string"
            },
            "row": {
              "type": "integer",
              "minimum": 1
            },
            "upgradeRow": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tutorialHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "enum": [
            "Above",
            "Below",
            "Left",
            "Right",
            "Center"
          ]
        },
        "offsetX": {
          "type": "number"
        },
        "offsetY": {
          "type": "number"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "damage",
            "toughness_damage",
            "bleed",
            "bleed_scaled_damage",
            "life_steal",
            "reflect_damage",
            "block_damage",
            "block_scaled_damage",
            "stun",
            "poison",
            "poison_scaled_next_attack",
            "poison_damage_bonus",
            "vulnerability",
            "nullify_attacks",
            "damage_reduction",
            "skip_enemy_turns",
            "draw_cards",
            "heal",
            "immunity",
            "summon_companion",
            "life_steal_max_health",
            "gain_resource",
            "play_cards_from_discard",
            "parry_counter",
            "invisible_attack",
            "mana_card_burst",
            "execution_double"
          ]
        },
        "amount": {
          "$ref": "#/$defs/numberOrPair"
        },
        "hits": {
          "$ref": "#/$defs/numberOrPair"
        },
        "unit": {
          "enum": [
            "points",
            "percent"
          ]
        },
        "multiplier": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
