{
  "dialogues": [
    {
      "dialogueId": "evt_light_intro",
      "lines": [
        { "speaker": "提灯人", "text": "……你在黑暗中走了很远。", "expression": "" },
        { "speaker": "艾薇儿", "text": "你是谁？你手里那盏灯……", "expression": "Thinking" },
        { "speaker": "提灯人", "text": "灯里装的不是火。是选择。", "expression": "" },
        { "speaker": "提灯人", "text": "选一张牌吧。每张牌都有代价，也有回报。但小心——有些选择不可挽回。", "expression": "" }
      ]
    },
    {
      "dialogueId": "evt_light_opt1",
      "lines": [
        { "speaker": "提灯人", "text": "你用鲜血换来了财富。有趣。", "expression": "" },
        { "speaker": "艾薇儿", "text": "咳……值得。", "expression": "Irritated" },
        { "speaker": "提灯人", "text": "走吧。灯会记得你的选择。", "expression": "" }
      ]
    },
    {
      "dialogueId": "evt_light_opt2",
      "lines": [
        { "speaker": "提灯人", "text": "金币换材料，公平交易。", "expression": "" },
        { "speaker": "艾薇儿", "text": "这些材料……有用。", "expression": "Professional Smile" },
        { "speaker": "提灯人", "text": "去吧。灯已照亮你的路。", "expression": "" }
      ]
    },
    {
      "dialogueId": "evt_light_end",
      "lines": [
        { "speaker": "提灯人", "text": "什么都不选？有时候不选也是一种选择。", "expression": "" },
        { "speaker": "艾薇儿", "text": "我只是想离开。", "expression": "Annoyed" },
        { "speaker": "提灯人", "text": "那就走吧。灯不会等第二次。", "expression": "" }
      ]
    }
  ]
}